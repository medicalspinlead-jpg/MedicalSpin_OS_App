generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Cliente {
  id           String        @id @default(uuid())
  razaoSocial  String        @map("razao_social")
  nomeFantasia String        @map("nome_fantasia")
  cnpj         String        @unique
  cidade       String
  uf           String
  telefone     String
  email        String
  responsavel  String
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  equipamentos Equipamento[]
  ordens       OrdemServico[]
  usuarios     Usuario[]
  solicitacoes Solicitacao[]
  departamentos ClienteDepartamento[]

  notifEmail    Boolean  @default(false) @map("notif_email")
  notifWhatsapp Boolean  @default(false) @map("notif_whatsapp")

  @@map("clientes")
}

model Equipamento {
  id          String   @id @default(uuid())
  clienteId   String   @map("cliente_id")
  tipo        String
  fabricante  String
  modelo      String
  numeroSerie String   @map("numero_serie")
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  cliente     Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  ordens      OrdemServico[]

  @@map("equipamentos")
}

model OrdemServico {
  id            String   @id @default(uuid())
  numero        String
  status        String   @default("rascunho")
  currentStep   Int      @default(1) @map("current_step")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  finalizedAt   DateTime? @map("finalized_at")
  
  // Dados da empresa (JSON)
  empresa       Json     @default("{}")
  
  // Relacionamentos
  clienteId     String?  @map("cliente_id")
  cliente       Cliente? @relation(fields: [clienteId], references: [id])
  equipamentoId String?  @map("equipamento_id")
  equipamento   Equipamento? @relation(fields: [equipamentoId], references: [id])
  
  // Campos JSON para dados complexos
  motivo        Json     @default("{}")
  intervencao   Json     @default("{}")
  pendencias    Json     @default("{}")
  estadoEquipamento Json @default("{}") @map("estado_equipamento")
  finalizacao   Json     @default("{}")
  midias        Json     @default("{}")
  
  // Relacionamentos com tabelas de itens
  pecas         Peca[]
  maoDeObra     MaoDeObra[]

  @@map("ordens_servico")
}

model Peca {
  id          String       @id @default(uuid())
  osId        String       @map("os_id")
  nome        String
  modeloRef   String?      @map("modelo_ref")
  numeroSerie String?      @map("numero_serie")
  observacoes String?
  quantidade  Int
  categoria   String       @default("cliente")
  tipo        String       @default("removida") // "removida" ou "inclusa"
  createdAt   DateTime     @default(now()) @map("created_at")
  ordem       OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)

  @@map("pecas")
}

model MaoDeObra {
  id          String       @id @default(uuid())
  osId        String       @map("os_id")
  data        String
  descricao   String
  horas       Float
  createdAt   DateTime     @default(now()) @map("created_at")
  ordem       OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)

  @@map("mao_de_obra")
}

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  telefone  String?
  senha     String
  cargo     String   @default("tecnico") // "admin", "tecnico", "cliente"
  ativo     Boolean  @default(true)
  clienteId String?  @map("cliente_id")
  cliente   Cliente? @relation(fields: [clienteId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  // Preferencias de notificacao
  notifEmail    Boolean  @default(false) @map("notif_email")
  notifWhatsapp Boolean  @default(false) @map("notif_whatsapp")
  
  departamentos        UsuarioDepartamento[]
  clientesResponsavel  ClienteDepartamento[]

  @@map("usuarios")
}

model Sessao {
  id        String   @id @default(uuid())
  usuarioId String   @map("usuario_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("sessoes")
}

model Configuracao {
  id              String   @id @default(uuid())
  emailHabilitado Boolean  @default(true) @map("email_habilitado")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("configuracoes")
}

model Solicitacao {
  id                 String   @id @default(uuid())
  protocolo          String   @unique
  status             String   @default("recebida")

  // Dados do solicitante
  nomeEmpresa        String   @map("nome_empresa")
  cnpj               String?
  nomeContato        String   @map("nome_contato")
  telefone           String
  email              String
  cidade             String
  uf                 String

  // Dados do equipamento
  tipoEquipamento    String   @map("tipo_equipamento")
  fabricante         String
  modelo             String
  numeroSerie        String?  @map("numero_serie")

  // Descricao do problema
  descricaoProblema  String   @map("descricao_problema")
  urgencia           String   @default("normal")

  // Midias (fotos e videos)
  midias             Json     @default("{}")

  // Motivo de cancelamento (obrigatorio quando cancelar)
  motivoCancelamento String?  @map("motivo_cancelamento")

  // Vinculo com OS
  ordemServicoId     String?  @map("ordem_servico_id")

  // Vinculo com Cliente
  clienteId          String?  @map("cliente_id")
  cliente            Cliente? @relation(fields: [clienteId], references: [id])

  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  historicoStatus    HistoricoStatusSolicitacao[]

  @@map("solicitacoes")
}

model HistoricoStatusSolicitacao {
  id             String      @id @default(uuid())
  solicitacaoId  String      @map("solicitacao_id")
  status         String
  observacao     String?
  usuarioNome    String?     @map("usuario_nome")
  criadoEm       DateTime    @default(now()) @map("criado_em")
  solicitacao    Solicitacao @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)

  @@map("historico_status_solicitacao")
}

model Departamento {
  id          String   @id @default(uuid())
  nome        String
  descricao   String?
  cor         String   @default("#3b82f6")
  icone       String   @default("Building2")
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  usuarios    UsuarioDepartamento[]
  clientes    ClienteDepartamento[]

  @@map("departamentos")
}

model UsuarioDepartamento {
  id              String       @id @default(uuid())
  usuarioId       String       @map("usuario_id")
  departamentoId  String       @map("departamento_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  
  usuario         Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  departamento    Departamento @relation(fields: [departamentoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, departamentoId])
  @@map("usuarios_departamentos")
}

model ClienteDepartamento {
  id                   String       @id @default(uuid())
  clienteId            String       @map("cliente_id")
  departamentoId       String       @map("departamento_id")
  usuarioResponsavelId String?      @map("usuario_responsavel_id")
  createdAt            DateTime     @default(now()) @map("created_at")
  
  cliente              Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  departamento         Departamento @relation(fields: [departamentoId], references: [id], onDelete: Cascade)
  usuarioResponsavel   Usuario?     @relation(fields: [usuarioResponsavelId], references: [id])

  @@unique([clienteId, departamentoId])
  @@map("clientes_departamentos")
}
